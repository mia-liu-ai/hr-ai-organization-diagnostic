VITE_API_BASE_URL=http://127.0.0.1:8008

# 后端数据库。本地默认使用 SQLite，后续可通过 DATABASE_URL 切换。
DATABASE_URL=sqlite:///./hr360.sqlite3

# 统一 AI Provider。DeepSeek 使用 OpenAI-compatible API，不要把 key 写入代码。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
